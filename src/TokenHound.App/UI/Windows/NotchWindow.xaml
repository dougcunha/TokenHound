<Window x:Class="TokenHound.App.UI.Windows.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TokenHound.App.UI.Controls"
        mc:Ignorable="d"
        Title="TokenHound"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MinWidth="180"
        MinHeight="48"
        WindowStartupLocation="Manual">

    <Grid Margin="12">
        <Border x:Name="CapsuleBorder"
                Background="#18181B"
                BorderBrush="#3F3F46"
                BorderThickness="1.5"
                CornerRadius="24"
                Padding="8,5"
                Cursor="Hand"
                SnapsToDevicePixels="True">
            <Border.ContextMenu>
                <ContextMenu x:Name="CapsuleContextMenu"
                             Style="{StaticResource HudContextMenuStyle}">
                    <MenuItem x:Name="CloseMenuItem"
                              Header="Close"
                              Style="{StaticResource HudMenuItemStyle}"
                              Click="OnCloseClick" />
                    <MenuItem x:Name="RefreshMenuItem"
                              Header="Refresh"
                              Style="{StaticResource HudMenuItemStyle}"
                              Click="OnRefreshClick" />
                    <MenuItem x:Name="SettingsMenuItem"
                              Header="Settings"
                              Style="{StaticResource HudMenuItemStyle}"
                              Click="OnSettingsClick" />
                    <MenuItem x:Name="AboutMenuItem"
                              Header="About"
                              Style="{StaticResource HudMenuItemStyle}"
                              Click="OnAboutClick" />
                </ContextMenu>
            </Border.ContextMenu>
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="20"
                                  ShadowDepth="4"
                                  Opacity="0.65"
                                  Direction="270" />
            </Border.Effect>
            <ItemsControl ItemsSource="{Binding Rings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ProviderRing UsedFraction="{Binding UsedFraction}"
                                               ProviderBadge="{Binding ProviderBadge}"
                                               GlyphKey="{Binding GlyphKey}"
                                               GlyphScale="{Binding GlyphScale}"
                                               Status="{Binding Status}"
                                               IsBusy="{Binding IsBusy}"
                                               Margin="3,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Popup x:Name="StatusPopup"
               PlacementTarget="{Binding ElementName=CapsuleBorder}"
               Placement="Bottom"
               VerticalOffset="4"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Fade">
            <Border Background="#18181B"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,6"
                    SnapsToDevicePixels="True"
                    Focusable="False"
                    Cursor="Hand"
                    MouseLeftButtonDown="OnStatusPopupMouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="12"
                                      ShadowDepth="2"
                                      Opacity="0.5"
                                      Direction="270" />
                </Border.Effect>
                <TextBlock x:Name="StatusText"
                           Foreground="#A1A1AA"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Focusable="False" />
            </Border>
        </Popup>
    </Grid>

</Window>
