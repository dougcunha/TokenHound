<Window x:Class="TokenHound.App.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings"
        Width="440"
        Height="280"
        MinWidth="380"
        MinHeight="220"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource SurfaceBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,14" />

        <!-- Empty Content Body -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceCardBackgroundBrush}"
                BorderBrush="{StaticResource SurfaceBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="120" />

        <!-- Dismissal Controls -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CloseButton"
                    Content="Close"
                    Style="{StaticResource DialogButtonStyle}"
                    IsCancel="True"
                    Click="OnCloseButtonClick"
                    AutomationProperties.Name="Close" />
        </StackPanel>
    </Grid>

</Window>
