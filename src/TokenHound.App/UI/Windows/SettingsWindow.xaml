<Window x:Class="TokenHound.App.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TokenHound.App.UI.Converters"
        xmlns:viewModels="clr-namespace:TokenHound.App.ViewModels"
        xmlns:settings="clr-namespace:TokenHound.App.UI.Controls.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
        Title="Settings"
        Icon="../../Assets/logo.ico"
        Width="480"
        Height="600"
        MinWidth="480"
        MinHeight="600"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource SurfaceBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource DialogScrollBarStyle}" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="Manage monitored AI coding assistants, polling cadence, and rate-limit resilience."
                   FontSize="12"
                   LineHeight="18"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <!-- Tabbed Content Area -->
        <TabControl x:Name="SettingsTabControl"
                    Grid.Row="2"
                    Style="{StaticResource SettingsTabControlStyle}"
                    SelectionChanged="OnTabSelectionChanged">
            <!-- Tab 1: General -->
            <TabItem x:Name="GeneralTab"
                     Header="General"
                     AutomationProperties.Name="General tab">
                <TabItem.Style>
                    <Style TargetType="TabItem" BasedOn="{StaticResource SettingsTabItemStyle}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Startup}" Value="{x:Null}" />
                                    <Condition Binding="{Binding HudSize}" Value="{x:Null}" />
                                    <Condition Binding="{Binding HudBackdrop}" Value="{x:Null}" />
                                    <Condition Binding="{Binding HudPlacement}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Margin="0,8,-4,0"
                              Padding="0,0,4,0">
                    <StackPanel>
                        <settings:StartupSettingsCard />
                        <settings:HudSizeSettingsCard />
                        <settings:HudBackdropSettingsCard />
                        <settings:HudPlacementSettingsCard />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Providers -->
            <TabItem x:Name="ProvidersTab"
                     Header="Providers"
                     Style="{StaticResource SettingsTabItemStyle}"
                     AutomationProperties.Name="Providers tab">
                <settings:ProvidersSettingsPanel />
            </TabItem>

            <!-- Tab 3: Cadence & Rate Limits -->
            <TabItem x:Name="CadenceTab"
                     Header="Cadence &amp; Rate Limits"
                     Style="{StaticResource SettingsTabItemStyle}"
                     AutomationProperties.Name="Cadence and Rate Limits tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Margin="0,8,-4,0"
                              Padding="0,0,4,0">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceCardBackgroundBrush}"
                                BorderBrush="{StaticResource SurfaceBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,0,4">
                            <StackPanel>
                                <!-- Polling Cadence Header -->
                                <TextBlock Text="Polling Cadence"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,2" />

                                <TextBlock Text="Configure how frequently TokenHound checks for quota data."
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,12" />

                                <!-- Active Refresh Interval -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Active Refresh Interval"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,2" />

                                    <TextBlock Grid.Row="1"
                                               Text="Used when an AI coding agent is busy (seconds, minimum 30s)"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,4" />

                                    <TextBox x:Name="ActiveIntervalTextBox"
                                             Grid.Row="2"
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding Cadence.ActiveIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                             TabIndex="1"
                                             AutomationProperties.Name="Active Refresh Interval"
                                             AutomationProperties.HelpText="Interval in seconds when coding agent is active (minimum 30 seconds)" />

                                    <TextBlock Grid.Row="3"
                                               Text="{Binding Cadence.ActiveIntervalError}"
                                               Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Active Refresh Interval error">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cadence.ActiveIntervalError}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cadence.ActiveIntervalError}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Idle Refresh Interval -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Idle Refresh Interval"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,2" />

                                    <TextBlock Grid.Row="1"
                                               Text="Used when all agent sessions are idle (seconds, minimum 30s, ≥ active)"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,4" />

                                    <TextBox x:Name="IdleIntervalTextBox"
                                             Grid.Row="2"
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding Cadence.IdleIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                             TabIndex="2"
                                             AutomationProperties.Name="Idle Refresh Interval"
                                             AutomationProperties.HelpText="Interval in seconds when agent sessions are idle (minimum 30 seconds, must not be shorter than active interval)" />

                                    <TextBlock Grid.Row="3"
                                               Text="{Binding Cadence.IdleIntervalError}"
                                               Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Idle Refresh Interval error">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cadence.IdleIntervalError}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cadence.IdleIntervalError}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Separator -->
                                <Rectangle Height="1"
                                           Fill="{StaticResource SurfaceBorderSubtleBrush}"
                                           Margin="0,0,0,12" />

                                <!-- Rate-Limit Resilience Header -->
                                <TextBlock Text="Rate-Limit Resilience (HTTP 429)"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,2" />

                                <TextBlock Text="Configure backoff penalties when provider APIs throttle."
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,12" />

                                <!-- Minimum Retry Floor -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Minimum Retry Floor"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,2" />

                                    <TextBlock Grid.Row="1"
                                               Text="Minimum wait before retrying after HTTP 429 throttling (seconds, minimum 60s)"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,4" />

                                    <TextBox x:Name="RetryFloorTextBox"
                                             Grid.Row="2"
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding Cadence.MinimumRetryFloorText, UpdateSourceTrigger=PropertyChanged}"
                                             TabIndex="3"
                                             AutomationProperties.Name="Minimum Retry Floor"
                                             AutomationProperties.HelpText="Minimum wait in seconds before retrying after an HTTP 429 response (minimum 60 seconds)" />

                                    <TextBlock Grid.Row="3"
                                               Text="{Binding Cadence.RetryFloorError}"
                                               Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Minimum Retry Floor error">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cadence.RetryFloorError}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cadence.RetryFloorError}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Updates -->
            <TabItem Header="Updates"
                     Style="{StaticResource SettingsTabItemStyle}"
                     AutomationProperties.Name="Updates tab">
                <settings:UpdatesSettingsPanel />
            </TabItem>
        </TabControl>

        <!-- Dismissal / Action Controls -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Reset to Defaults Button -->
            <Button x:Name="ResetButton"
                    Grid.Column="0"
                    Content="Reset to Defaults"
                    TabIndex="4"
                    Click="OnResetButtonClick"
                    AutomationProperties.Name="Reset to Defaults"
                    AutomationProperties.HelpText="Reset cadence and rate-limit intervals to recommended factory defaults">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, ElementName=CadenceTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Feedback Indicator (status / apply error) -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <TextBlock x:Name="StatusMessageTextBlock"
                           Text="Settings applied"
                           Foreground="{StaticResource BadgeOkForegroundBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           Visibility="Collapsed"
                           AutomationProperties.Name="Settings application status" />
                <TextBlock Text="{Binding Cadence.ApplyError}"
                           Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Settings application error">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cadence.ApplyError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cadence.ApplyError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Cancel, Close, and Apply Buttons -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <Button x:Name="CloseButton"
                        Content="Close"
                        TabIndex="5"
                        IsCancel="True"
                        Click="OnCancelButtonClick"
                        AutomationProperties.Name="Close"
                        AutomationProperties.HelpText="Close settings dialog">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=CadenceTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        TabIndex="6"
                        IsCancel="True"
                        Click="OnCancelButtonClick"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Cancel"
                        AutomationProperties.HelpText="Discard cadence changes and close dialog">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=CadenceTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="ApplyButton"
                        Content="Apply"
                        TabIndex="7"
                        Command="{Binding Cadence.ApplyCommand}"
                        Click="OnApplyButtonClick"
                        AutomationProperties.Name="Apply"
                        AutomationProperties.HelpText="Apply cadence and rate limit changes to running application and save to settings">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=CadenceTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>

</Window>
