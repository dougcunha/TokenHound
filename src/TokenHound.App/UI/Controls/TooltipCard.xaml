<UserControl x:Class="TokenHound.App.UI.Controls.TooltipCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TokenHound.App.UI.Controls"
             xmlns:vm="clr-namespace:TokenHound.App.ViewModels"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <local:UsedFractionToBrushConverter x:Key="FractionBrushConverter" />

        <ControlTemplate x:Key="FlatProgressBarTemplate" TargetType="ProgressBar">
            <Grid>
                <Border Background="#27272A" CornerRadius="3" />
                <Border x:Name="PART_Track" />
                <Border x:Name="PART_Indicator"
                        HorizontalAlignment="Left"
                        CornerRadius="3"
                        Background="{TemplateBinding Foreground}" />
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <Border Background="#121214"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            MinWidth="260"
            MaxWidth="320">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="16"
                              ShadowDepth="4"
                              Opacity="0.55"
                              Direction="270" />
        </Border.Effect>

        <StackPanel>

            <!-- Header: Provider Name + Status Pill -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ProviderNameText"
                           Grid.Column="0"
                           Foreground="#F4F4F5"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Border x:Name="StatusBadge"
                        Grid.Column="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Background="#064E3B"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText"
                               Text="OK"
                               FontSize="10"
                               FontWeight="Medium"
                               Foreground="#34D399" />
                </Border>
            </Grid>

            <!-- Separator -->
            <Rectangle Height="1"
                       Fill="#1E1E24"
                       Margin="0,10,0,10" />

            <!-- Rows Section -->
            <ItemsControl x:Name="RowsControl"
                          ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProviderUsageRow}">
                        <StackPanel Margin="0,0,0,10">

                            <!-- Row Header: Label + Reset Countdown -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Foreground="#9CA3AF"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ResetText}"
                                           Foreground="#9CA3AF"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           Visibility="{Binding HasReset, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- Scope (e.g. Org/Account) -->
                            <TextBlock Text="{Binding ScopeText}"
                                       Foreground="#71717A"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,3"
                                       Visibility="{Binding HasScope, Converter={StaticResource BoolToVis}}" />

                            <!-- Progress Bar Track -->
                            <ProgressBar Minimum="0"
                                         Maximum="1"
                                         Value="{Binding ClampedFraction, Mode=OneWay}"
                                         Foreground="{Binding ClampedFraction, Converter={StaticResource FractionBrushConverter}}"
                                         Template="{StaticResource FlatProgressBarTemplate}"
                                         Height="6"
                                         Margin="0,2,0,3"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />

                            <!-- Primary and Secondary Quantities -->
                            <WrapPanel Orientation="Horizontal"
                                       Margin="0,0,0,2">
                                <TextBlock Text="{Binding PrimaryQuantityText}"
                                           Foreground="#E4E4E7"
                                           FontSize="11"
                                           FontWeight="Medium" />

                                <TextBlock Text="{Binding SecondaryQuantityText}"
                                           Foreground="#71717A"
                                           FontSize="10"
                                           Margin="6,1,0,0"
                                           Visibility="{Binding HasSecondaryQuantity, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>

                            <!-- Provenance and Coverage Info -->
                            <TextBlock Text="{Binding ProvenanceText}"
                                       Foreground="#71717A"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0"
                                       Visibility="{Binding HasProvenance, Converter={StaticResource BoolToVis}}" />

                            <!-- Row-Level Error/Warning Panel -->
                            <Border Background="#2D1515"
                                    BorderBrush="#7F1D1D"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,3"
                                    Margin="0,4,0,0"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ErrorText}"
                                           Foreground="#FCA5A5"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </Border>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Active Session Row -->
            <Border x:Name="ActiveSessionPanel"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8,4"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="ActiveSessionTextBlock"
                           Foreground="#A1A1AA"
                           FontSize="10" />
            </Border>

            <!-- Status Message / Action Guidance Box -->
            <Border x:Name="StatusMessagePanel"
                    CornerRadius="6"
                    BorderThickness="1"
                    Padding="8,6"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusMessageTextBlock"
                           TextWrapping="Wrap"
                           FontSize="11" />
            </Border>

        </StackPanel>

    </Border>

</UserControl>
