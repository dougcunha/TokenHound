<UserControl x:Class="TokenHound.App.UI.Controls.TooltipCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <Border Background="#121214"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            MinWidth="260"
            MaxWidth="320">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="16"
                              ShadowDepth="4"
                              Opacity="0.55"
                              Direction="270" />
        </Border.Effect>

        <StackPanel>

            <!-- Header: Provider Name + Status Pill -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ProviderNameText"
                           Grid.Column="0"
                           Foreground="#F4F4F5"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Border x:Name="StatusBadge"
                        Grid.Column="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Background="#064E3B"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText"
                               Text="OK"
                               FontSize="10"
                               FontWeight="Medium"
                               Foreground="#34D399" />
                </Border>
            </Grid>

            <!-- Separator -->
            <Rectangle Height="1"
                       Fill="#1E1E24"
                       Margin="0,10,0,10" />

            <!-- Session Quota Section -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Current session (5h)"
                           Foreground="#9CA3AF"
                           FontSize="11" />

                <TextBlock x:Name="SessionResetTextBlock"
                           Grid.Column="1"
                           Foreground="#9CA3AF"
                           FontSize="11" />
            </Grid>

            <!-- Session Bar Track -->
            <Grid x:Name="SessionBarTrack"
                  Height="6"
                  Margin="0,0,0,3">
                <Border Background="#27272A"
                        CornerRadius="3" />
                <Border x:Name="SessionBarFill"
                        Background="#10B981"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        Width="0" />
            </Grid>

            <!-- Session Used Text -->
            <TextBlock x:Name="SessionPercentText"
                       Text="Unmeasured"
                       Foreground="#E4E4E7"
                       FontSize="11"
                       FontWeight="Medium"
                       Margin="0,0,0,10" />

            <!-- Weekly Quota Section -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Weekly limit (7d)"
                           Foreground="#9CA3AF"
                           FontSize="11" />

                <TextBlock x:Name="WeeklyResetTextBlock"
                           Grid.Column="1"
                           Foreground="#9CA3AF"
                           FontSize="11" />
            </Grid>

            <!-- Weekly Bar Track -->
            <Grid x:Name="WeeklyBarTrack"
                  Height="6"
                  Margin="0,0,0,3">
                <Border Background="#27272A"
                        CornerRadius="3" />
                <Border x:Name="WeeklyBarFill"
                        Background="#10B981"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        Width="0" />
            </Grid>

            <!-- Weekly Used Text -->
            <TextBlock x:Name="WeeklyPercentText"
                       Text="Unmeasured"
                       Foreground="#E4E4E7"
                       FontSize="11"
                       FontWeight="Medium"
                       Margin="0,0,0,8" />

            <!-- Active Session Row -->
            <Border x:Name="ActiveSessionPanel"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8,4"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="ActiveSessionTextBlock"
                           Foreground="#A1A1AA"
                           FontSize="10" />
            </Border>

            <!-- Status Message / Action Guidance Box -->
            <Border x:Name="StatusMessagePanel"
                    CornerRadius="6"
                    BorderThickness="1"
                    Padding="8,6"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusMessageTextBlock"
                           TextWrapping="Wrap"
                           FontSize="11" />
            </Border>

        </StackPanel>

    </Border>

</UserControl>
