<UserControl x:Class="TokenHound.App.UI.Controls.Settings.HudBackdropSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TokenHound.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">

    <Border Background="{StaticResource SurfaceCardBackgroundBrush}"
            BorderBrush="{StaticResource SurfaceBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12"
            Margin="0,0,0,12"
            DataContext="{Binding HudBackdrop}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="Translucent background"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,2" />
            <TextBlock Text="Blurs what is behind the HUD. Uses the solid background when Windows transparency effects are off, or when energy saver or high contrast is on."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,12" />
            <CheckBox IsChecked="{Binding IsEnabled}"
                      Content="Use a translucent HUD background"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="12"
                      AutomationProperties.Name="Use a translucent HUD background"
                      AutomationProperties.HelpText="Turns the blurred HUD background on or off immediately" />
            <TextBlock Text="Transparency"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,10,0,4" />
            <Grid IsEnabled="{Binding IsEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="TransparencySlider"
                        Minimum="{Binding Minimum}"
                        Maximum="{Binding Maximum}"
                        Value="{Binding Transparency, Mode=TwoWay, Delay=200}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        SmallChange="1"
                        LargeChange="5"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="HUD background transparency"
                        AutomationProperties.HelpText="Sets how much of the blur shows through the HUD, from 0 to 50 percent; higher values reduce contrast over bright backgrounds" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Value, ElementName=TransparencySlider, StringFormat={}{0:0}%}"
                           Width="48"
                           TextAlignment="Right"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
            <Border Background="{StaticResource BadgeNeedsAuthBackgroundBrush}"
                    BorderBrush="{StaticResource BadgeNeedsAuthForegroundBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Preference.Notice}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Preference.Notice}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Translucent background unavailable"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Content="Open Windows settings"
                            Command="{Binding OpenSystemSettingsCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="Open Windows settings for the translucent background">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preference.SystemSettingsUri}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding ApplyError}"
                       Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                       FontSize="11"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Translucent background error">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ApplyError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
