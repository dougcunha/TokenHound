<UserControl x:Class="TokenHound.App.UI.Controls.Settings.HudSizeSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TokenHound.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">

    <Border Background="{StaticResource SurfaceCardBackgroundBrush}"
            BorderBrush="{StaticResource SurfaceBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12"
            Margin="0,0,0,12"
            DataContext="{Binding HudSize}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="HUD size"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,2" />
            <TextBlock Text="Scales the HUD, its tooltips, and its status popup."
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="{Binding Minimum}"
                        Maximum="{Binding Maximum}"
                        Value="{Binding Percent, Mode=TwoWay}"
                        TickFrequency="{Binding Step}"
                        IsSnapToTickEnabled="True"
                        SmallChange="5"
                        LargeChange="10"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="HUD size"
                        AutomationProperties.HelpText="Sets the HUD size between 50 and 150 percent when you apply" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           Width="48"
                           TextAlignment="Right"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="HUD size value" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Small"
                        Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding PresetCommand}"
                        CommandParameter="75"
                        AutomationProperties.Name="Small HUD size, 75 percent" />
                <Button Content="Default"
                        Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding PresetCommand}"
                        CommandParameter="100"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Default HUD size, 100 percent" />
                <Button Content="Large"
                        Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding PresetCommand}"
                        CommandParameter="125"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Large HUD size, 125 percent" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Apply"
                        Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding ApplyCommand}"
                        AutomationProperties.Name="Apply HUD size" />
                <TextBlock Text="Settings applied"
                           Foreground="{StaticResource BadgeOkForegroundBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           AutomationProperties.Name="HUD size status">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <TextBlock Text="{Binding ApplyError}"
                       Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                       FontSize="11"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="HUD size error">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ApplyError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
