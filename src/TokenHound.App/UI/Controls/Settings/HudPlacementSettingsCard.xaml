<UserControl x:Class="TokenHound.App.UI.Controls.Settings.HudPlacementSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TokenHound.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">

    <UserControl.Resources>
        <ResourceDictionary Source="../../Styles/SettingsResources.xaml" />
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceCardBackgroundBrush}"
            BorderBrush="{StaticResource SurfaceBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12"
            Margin="0,0,0,4"
            DataContext="{Binding HudPlacement}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="HUD placement"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,2" />
            <TextBlock Text="Docks the HUD to a screen edge of the chosen display. Changes apply immediately."
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Position"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          Style="{StaticResource DialogComboBoxStyle}"
                          ItemsSource="{Binding Modes}"
                          SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                          ItemTemplate="{StaticResource LabelItemTemplate}"
                          AutomationProperties.Name="HUD position" />
                <TextBlock Grid.Row="2"
                           Text="Display"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          Style="{StaticResource DialogComboBoxStyle}"
                          ItemsSource="{Binding Displays}"
                          SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}"
                          ItemTemplate="{StaticResource LabelItemTemplate}"
                          IsEnabled="{Binding IsDisplayEnabled}"
                          AutomationProperties.Name="HUD display" />
            </Grid>
            <TextBlock Text="{Binding DisplayHint}"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="72,6,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="HUD display hint">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayHint}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding SaveError}"
                       Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                       FontSize="11"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="HUD placement error">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
