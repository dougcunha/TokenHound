<UserControl x:Class="TokenHound.App.UI.Controls.Settings.UpdatesSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TokenHound.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">

    <UserControl.Resources>
        <ResourceDictionary Source="../../Styles/SettingsResources.xaml" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Margin="0,8,-4,0"
                  Padding="0,0,4,0">
        <Border Background="{StaticResource SurfaceCardBackgroundBrush}"
                BorderBrush="{StaticResource SurfaceBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,4"
                DataContext="{Binding Updates}">
            <StackPanel>
                <TextBlock Text="Automatic Updates"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,2" />
                <TextBlock Text="TokenHound checks GitHub releases and asks before installing anything."
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12" />
                <CheckBox IsChecked="{Binding IsEnabled}"
                          Content="Check for updates automatically"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="12"
                          Margin="0,0,0,12"
                          AutomationProperties.Name="Check for updates automatically" />
                <TextBlock Text="Check Interval"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,2" />
                <TextBlock Text="Hours between automatic checks (0 turns periodic checks off, maximum 720)"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,4" />
                <TextBox Style="{StaticResource SettingsTextBoxStyle}"
                         Text="{Binding IntervalHoursText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Check Interval"
                         AutomationProperties.HelpText="Hours between automatic update checks; 0 turns periodic checks off" />
                <TextBlock Text="{Binding IntervalError}"
                           Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                           FontSize="11"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Check Interval error">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IntervalError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Apply"
                            Style="{StaticResource DialogButtonStyle}"
                            Command="{Binding ApplyCommand}"
                            AutomationProperties.Name="Apply update settings" />
                    <TextBlock Text="Settings applied"
                               Foreground="{StaticResource BadgeOkForegroundBrush}"
                               FontSize="12"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               AutomationProperties.Name="Update settings status">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ApplyError}"
                               Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Update settings error">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ApplyError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
