<UserControl x:Class="TokenHound.App.UI.Controls.Settings.ProvidersSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TokenHound.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">

    <UserControl.Resources>
        <ResourceDictionary Source="../../Styles/SettingsResources.xaml" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Margin="0,8,-4,0"
                  Padding="0,0,4,0">
        <StackPanel>
            <TextBlock Text="Monitored Providers"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />

            <Border Background="{StaticResource SurfaceCardBackgroundBrush}"
                    BorderBrush="{StaticResource SurfaceBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0,6"
                    Margin="0,0,0,8">
                <ItemsControl x:Name="ProviderItems"
                              ItemsSource="{Binding Providers}"
                              ItemTemplate="{StaticResource ProviderRowTemplate}"
                              KeyboardNavigation.TabNavigation="Continue"
                              AutomationProperties.Name="Monitored providers" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
