<UserControl x:Class="TokenHound.App.UI.Controls.Settings.StartupSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TokenHound.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">

    <Border Background="{StaticResource SurfaceCardBackgroundBrush}"
            BorderBrush="{StaticResource SurfaceBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12"
            Margin="0,0,0,12"
            DataContext="{Binding Startup}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="Startup"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,2" />
            <TextBlock Text="Adds a shortcut to your Windows Startup folder."
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,12" />
            <CheckBox IsChecked="{Binding IsEnabled}"
                      Content="Start TokenHound when I sign in to Windows"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="12"
                      AutomationProperties.Name="Start TokenHound when I sign in to Windows"
                      AutomationProperties.HelpText="Adds or removes the TokenHound shortcut in your Windows Startup folder when you apply" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Apply"
                        Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding ApplyCommand}"
                        AutomationProperties.Name="Apply startup settings" />
                <TextBlock Text="Settings applied"
                           Foreground="{StaticResource BadgeOkForegroundBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           AutomationProperties.Name="Startup settings status">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <TextBlock Text="{Binding ApplyError}"
                       Foreground="{StaticResource BadgeAccessDeniedForegroundBrush}"
                       FontSize="11"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Startup settings error">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ApplyError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
