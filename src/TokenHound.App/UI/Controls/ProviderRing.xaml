<UserControl x:Class="TokenHound.App.UI.Controls.ProviderRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TokenHound.App.UI.Controls"
             mc:Ignorable="d"
             Width="44"
             Height="44">

    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BusyIndicator"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25"
                             To="1.0"
                             Duration="0:0:0.6" />
        </Storyboard>
    </UserControl.Resources>

    <UserControl.ToolTip>
        <ToolTip Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 HasDropShadow="False">
            <local:TooltipCard
                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                ProviderName="{Binding ProviderName, FallbackValue='Claude'}"
                Status="{Binding PlacementTarget.Status, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                SessionUsedFraction="{Binding SessionUsedFraction}"
                SessionResetText="{Binding SessionResetText}"
                WeeklyUsedFraction="{Binding WeeklyUsedFraction}"
                WeeklyResetText="{Binding WeeklyResetText}"
                ActiveSessionText="{Binding ActiveSessionText}"
                StatusMessage="{Binding StatusMessage}" />
        </ToolTip>
    </UserControl.ToolTip>

    <Grid Width="44"
          Height="44">

        <Ellipse Width="36"
                 Height="36"
                 Fill="#18181B"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

        <Ellipse x:Name="TrackRing"
                 Width="36"
                 Height="36"
                 Stroke="#27272A"
                 StrokeThickness="3"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

        <Path x:Name="ArcProgressPath"
              Width="44"
              Height="44"
              Stroke="#10B981"
              StrokeThickness="3"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />

        <TextBlock x:Name="BadgeTextBlock"
                   Text="{Binding ProviderBadge, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="#F4F4F5"
                   FontSize="13"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <Path x:Name="GlyphPath"
              Fill="#F4F4F5"
              Stretch="Uniform"
              Width="18"
              Height="18"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="Collapsed" />

        <Ellipse x:Name="StatusDot"
                 Width="6"
                 Height="6"
                 Fill="#10B981"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,5,5"
                 Visibility="Collapsed" />

        <Ellipse x:Name="BusyIndicator"
                 Width="6"
                 Height="6"
                 Fill="#10B981"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,7"
                 Visibility="Collapsed" />

    </Grid>

</UserControl>
