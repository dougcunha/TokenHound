<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette -->
    <Color x:Key="SurfaceBackgroundColor">#18181B</Color>
    <Color x:Key="SurfaceCardBackgroundColor">#121214</Color>
    <Color x:Key="SurfaceBorderColor">#3F3F46</Color>
    <Color x:Key="SurfaceBorderSubtleColor">#27272A</Color>
    <Color x:Key="TextPrimaryColor">#F4F4F5</Color>
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <Color x:Key="TextMutedColor">#71717A</Color>
    <Color x:Key="ButtonBackgroundColor">#27272A</Color>
    <Color x:Key="ButtonHoverBackgroundColor">#3F3F46</Color>
    <Color x:Key="ButtonPressedBackgroundColor">#52525B</Color>
    <Color x:Key="ButtonDisabledBackgroundColor">#18181B</Color>
    <Color x:Key="FocusIndicatorColor">#60A5FA</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceCardBackgroundBrush" Color="{StaticResource SurfaceCardBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}" />
    <SolidColorBrush x:Key="SurfaceBorderSubtleBrush" Color="{StaticResource SurfaceBorderSubtleColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{StaticResource ButtonHoverBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{StaticResource ButtonPressedBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="{StaticResource ButtonDisabledBackgroundColor}" />
    <SolidColorBrush x:Key="FocusIndicatorBrush" Color="{StaticResource FocusIndicatorColor}" />

    <!--
        Provider status badge palette. Key names are produced by ProviderBadgeResolver and must match it
        character for character. ProviderBadgeState.Unsupported and ProviderBadgeState.NotRunning
        deliberately reuse the Stale slate pair, so eight states map onto fourteen brushes. Background
        colors carry alpha and composite over SurfaceCardBackgroundBrush.
    -->
    <SolidColorBrush x:Key="BadgeOkBackgroundBrush" Color="#202E7D32" />
    <SolidColorBrush x:Key="BadgeOkForegroundBrush" Color="#81C784" />
    <SolidColorBrush x:Key="BadgeStaleBackgroundBrush" Color="#20546E7A" />
    <SolidColorBrush x:Key="BadgeStaleForegroundBrush" Color="#B0BEC5" />
    <SolidColorBrush x:Key="BadgeNeedsAuthBackgroundBrush" Color="#20E65100" />
    <SolidColorBrush x:Key="BadgeNeedsAuthForegroundBrush" Color="#FFB74D" />
    <SolidColorBrush x:Key="BadgeRateLimitedBackgroundBrush" Color="#20F57F17" />
    <SolidColorBrush x:Key="BadgeRateLimitedForegroundBrush" Color="#FFF176" />
    <SolidColorBrush x:Key="BadgeAccessDeniedBackgroundBrush" Color="#20C62828" />
    <SolidColorBrush x:Key="BadgeAccessDeniedForegroundBrush" Color="#E57373" />
    <SolidColorBrush x:Key="BadgeCheckingBackgroundBrush" Color="#2000838F" />
    <SolidColorBrush x:Key="BadgeCheckingForegroundBrush" Color="#80DEEA" />
    <SolidColorBrush x:Key="BadgeDisabledBackgroundBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="BadgeDisabledForegroundBrush" Color="#757575" />

    <!-- Toggle Palette -->
    <Color x:Key="ToggleBorderColor">#71717A</Color>
    <Color x:Key="ToggleCheckedColor">#3B82F6</Color>
    <Color x:Key="ToggleCheckedHoverColor">#60A5FA</Color>
    <Color x:Key="ToggleGlyphColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="ToggleBorderBrush" Color="{StaticResource ToggleBorderColor}" />
    <SolidColorBrush x:Key="ToggleCheckedBrush" Color="{StaticResource ToggleCheckedColor}" />
    <SolidColorBrush x:Key="ToggleCheckedHoverBrush" Color="{StaticResource ToggleCheckedHoverColor}" />
    <SolidColorBrush x:Key="ToggleGlyphBrush" Color="{StaticResource ToggleGlyphColor}" />

    <!-- Focus Visual Style -->
    <Style x:Key="DialogFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{StaticResource FocusIndicatorBrush}"
                               StrokeThickness="1.5"
                               StrokeDashArray="2 2"
                               Margin="-2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
